PORT=3000

# Instagram API (Instagram Login) - atende em graph.instagram.com
# ID da conta Instagram Business/Creator (não é o @usuario, é o ig-user-id numérico)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Token de acesso (prefixo "IGAA...") com permissão instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=
# Versão da API
GRAPH_API_VERSION=v21.0
