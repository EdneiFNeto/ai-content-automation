# Porta local. NÃO setar em produção no Render — ele injeta a própria porta
# (o código lê de process.env.PORT).
PORT=3000

# Nome que aparece nas páginas /legal/terms e /legal/privacy (serviço é
# multi-projeto). Opcional — default: "Content Publisher".
LEGAL_ENTITY_NAME=

# Instagram API (Instagram Login) - atende em graph.instagram.com
# ID da conta Instagram Business/Creator (não é o @usuario, é o ig-user-id numérico)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Token de acesso (prefixo "IGAA...") com permissão instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=
# Versão da API
GRAPH_API_VERSION=v21.0

# Gemini API (Nano Banana) - geração de imagem
# Chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional — default: gemini-3.1-flash-image (Nano Banana 2)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# TikTok Content Posting API
# Client Key/Secret do app, gerados em https://developers.tiktok.com ao criar o app
# (produtos "Login Kit" + "Content Posting API")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL do servidor que recebe o callback OAuth — precisa bater exatamente com a
# URI cadastrada no app TikTok (Login Kit → Redirect URI). Em produção:
# https://<seu-serviço>.onrender.com/auth/tiktok/callback
TIKTOK_REDIRECT_URI=
# Opcional — default: user.info.basic,video.publish
TIKTOK_SCOPES=user.info.basic,video.publish
# Gerados ao completar o fluxo em GET /auth/tiktok/login (copiar da resposta do
# /callback). O access token dura 24h; o refresh token, semanas (renovação
# automática via TikTokService.refreshAccessToken() ainda não está plugada).
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Requer app auditado pelo TikTok para publicar fora de SELF_ONLY
# Opcional — default: SELF_ONLY (único nível liberado sem auditoria do app)
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Facebook - publicação na Página (opcional; sem isto o Facebook fica "skipped")
# ID numérico da Página (aparece no Graph API Explorer ou em Página > Sobre)
FACEBOOK_PAGE_ID=
# Page Access Token com permissão pages_manage_posts. Gerado no Graph API
# Explorer (developers.facebook.com/tools/explorer) selecionando o app + a
# Página; troque por um token de longa duração. Enquanto o app estiver em modo
# dev, só admins/devs/testers do app conseguem publicar (sem App Review).
FACEBOOK_PAGE_ACCESS_TOKEN=
# Opcional — default: GRAPH_API_VERSION ou v21.0
FB_GRAPH_API_VERSION=
